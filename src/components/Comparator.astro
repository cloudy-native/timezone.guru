---
/**
 * Markup shell for the timezone comparator.
 * Interactivity is pure client JS (see src/scripts/app.ts).
 */
---

<div class="app" data-app>
  <section class="panel panel-setup" aria-label="Date and cities">
    <div class="toolbar">
      <div class="date-row">
        <label class="field-label-visually" for="date-input">Date</label>
        <input id="date-input" type="date" data-date />
        <button type="button" class="btn btn-ghost" data-today>Today</button>
      </div>

      <label class="switch" title="Toggle 12-hour or 24-hour clock">
        <span class="switch-side" data-clock-off>12h</span>
        <span class="switch-track">
          <input
            type="checkbox"
            data-clock-toggle
            checked
            role="switch"
            aria-label="24-hour clock"
          />
          <span class="switch-thumb" aria-hidden="true"></span>
        </span>
        <span class="switch-side" data-clock-on>24h</span>
      </label>
    </div>

    <div class="city-picker" data-city-picker>
      <label class="field-label-visually" for="city-search">Add city</label>
      <input
        id="city-search"
        type="search"
        data-search
        placeholder="Add a city…"
        autocomplete="off"
        enterkeyhint="search"
      />
      <ul class="suggestions" data-suggestions hidden></ul>
      <div class="chips" data-chips></div>
    </div>
  </section>

  <section class="panel panel-grid" aria-label="Schedule comparison">
    <div class="legend" aria-label="How to read the schedule">
      <span class="legend-group legend-quality">
        <span class="legend-title">Who’s free</span>
        <span class="legend-pill avail-none">
          <span class="legend-emoji" aria-hidden="true">🌒</span>
          <span class="legend-text">Nobody</span>
        </span>
        <span class="legend-pill avail-low">
          <span class="legend-emoji" aria-hidden="true">😴</span>
          <span class="legend-text">Few</span>
        </span>
        <span class="legend-pill avail-mid">
          <span class="legend-emoji" aria-hidden="true">😐</span>
          <span class="legend-text">Some</span>
        </span>
        <span class="legend-pill avail-high">
          <span class="legend-emoji" aria-hidden="true">🙂</span>
          <span class="legend-text">Most</span>
        </span>
        <span class="legend-pill avail-full">
          <span class="legend-emoji" aria-hidden="true">☀️</span>
          <span class="legend-text">All</span>
        </span>
      </span>
      <span class="legend-group legend-activity">
        <span class="legend-title">In each city</span>
        <span class="legend-pill act-sleep">
          <span class="legend-emoji" aria-hidden="true">💤</span>
          <span class="legend-text">Sleep</span>
        </span>
        <span class="legend-pill act-work">
          <span class="legend-emoji" aria-hidden="true">⚒️</span>
          <span class="legend-text">Work</span>
        </span>
        <span class="legend-pill act-awake">
          <span class="legend-emoji" aria-hidden="true">☕</span>
          <span class="legend-text">Awake</span>
        </span>
      </span>
    </div>

    <div class="empty-state" data-empty hidden>
      <p>Add a city to compare.</p>
    </div>

    <div
      class="grid-wrap"
      data-grid
      role="region"
      aria-label="Timezone comparison grid"
    >
    </div>

    <div class="share-bar" data-share>
      <div class="share-actions">
        <button type="button" class="btn btn-primary btn-block" data-share-copy>
          Copy link
        </button>
        <button type="button" class="btn btn-block" data-share-native hidden>
          Share…
        </button>
        <span class="share-status" data-share-status aria-live="polite"></span>
      </div>
      <div class="share-options">
        <label class="share-opt">
          <input type="checkbox" data-share-date />
          Date
        </label>
        <label class="share-opt">
          <input type="checkbox" data-share-activities />
          Day template
        </label>
      </div>
    </div>
  </section>

  <details class="panel secondary">
    <summary>Typical day (sleep / work / awake)</summary>

    <div class="secondary-body">
      <div class="brush-row">
        <span class="field-label">Paint with</span>
        <div data-brush></div>
      </div>

      <div class="preset-row" data-presets>
        <span class="field-label">Presets</span>
        <button type="button" class="btn btn-sm" data-preset="workday">Workday 09–17</button>
        <button type="button" class="btn btn-sm" data-preset="sleep">All sleep</button>
        <button type="button" class="btn btn-sm" data-preset="awake">All awake</button>
        <button type="button" class="btn btn-sm" data-preset="reset">Reset</button>
      </div>

      <div data-painter aria-label="Activity day editor"></div>
    </div>
  </details>
</div>

<script>
  import "../scripts/app";
</script>
