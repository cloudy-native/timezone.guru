---
/**
 * Compact home hero — value prop without pushing the tool down the fold.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="hero-kicker">Remote teams · global clients · family abroad</p>
    <h2 id="hero-title" class="hero-title">Find a time that works for everyone</h2>
    <p class="hero-lead">
      Compare cities side by side. Hours are rows, places are columns, built for phones.
      Daylight saving is handled for you.
    </p>
  </div>
  <ul class="hero-points">
    <li>
      <span class="hero-point-mark" aria-hidden="true">1</span>
      <span>Add the cities you care about</span>
    </li>
    <li>
      <span class="hero-point-mark" aria-hidden="true">2</span>
      <span>Scan the green <strong>You</strong> column for overlap</span>
    </li>
    <li>
      <span class="hero-point-mark" aria-hidden="true">3</span>
      <span>Choose a date (clocks adjust automatically)</span>
    </li>
  </ul>
</section>
