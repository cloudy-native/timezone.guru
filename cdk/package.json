{
  "name": "timezone-guru-cdk",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK stack for timezone.guru static hosting",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
