{
  "name": "timezone-guru",
  "version": "2.0.0",
  "private": true,
  "description": "Compare schedules across time zones",
  "author": "Stephen Harrison",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "site:build": "astro build",
    "preview": "astro preview",
    "serve": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "cities:extract": "node scripts/extract-cities.mjs",
    "site:deploy": "pnpm site:build && pnpm --filter timezone-guru-cdk deploy",
    "deploy": "pnpm site:deploy",
    "cdk": "pnpm --filter timezone-guru-cdk exec cdk",
    "cdk:deploy": "pnpm --filter timezone-guru-cdk deploy",
    "cdk:diff": "pnpm --filter timezone-guru-cdk exec cdk diff"
  },
  "dependencies": {
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.10.2",
    "@vvo/tzdb": "^6.198.0",
    "typescript": "^5.7.2"
  }
}
