{
  "name": "timezone-guru",
  "version": "2.0.0",
  "private": true,
  "description": "Compare schedules across time zones",
  "author": "Stephen Harrison",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "serve": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "deploy": "pnpm build && pnpm --dir cdk install && pnpm --dir cdk deploy",
    "cdk": "pnpm --dir cdk exec cdk"
  },
  "dependencies": {
    "@vvo/tzdb": "^6.198.0",
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
